# Local development settings. Copy to .env (`make env` does this) and edit.
# .env is git-ignored. Never put real credentials or real data here.
#
# Format: plain KEY=value lines, no quotes or spaces; both make and docker
# compose read this file.

# --- Docker Compose (deploy/compose.yaml) ---------------------------------
# Superuser password for the local PostgreSQL container. Local only.
# Keep it URL-safe (letters, digits, - _): the Makefile embeds it in the
# test-harness URL (STUDIO_TEST_DATABASE_URL).
STUDIO_PG_BOOTSTRAP_PASSWORD=local-dev-only-change-me
STUDIO_PG_PORT=55432

# The Makefile derives STUDIO_TEST_DATABASE_URL from the two values above and
# passes it only to the `make test-integration` test command. That URL
# connects as the bootstrap superuser and is used only for test setup.

# --- Database roles (plan section 6) --------------------------------------
# Login-role passwords, set by `make db-setup` (studioctl db bootstrap) and
# used by the integration tests. Local only; printable ASCII, no spaces,
# at least 12 characters, URL-safe.
STUDIO_DB_MIGRATOR_PASSWORD=local-dev-only-migrator
STUDIO_DB_APP_PASSWORD=local-dev-only-app-role
STUDIO_DB_WORKER_PASSWORD=local-dev-only-worker
STUDIO_DB_BACKUP_PASSWORD=local-dev-only-backup
STUDIO_DB_READONLY_PASSWORD=local-dev-only-readonly

# --- Application processes -------------------------------------------------
STUDIO_LOG_LEVEL=info
STUDIO_LOG_FORMAT=json
STUDIO_HTTP_ADDR=127.0.0.1:8480
STUDIO_SHUTDOWN_TIMEOUT=20s
# Optional. Empty means /readyz reports no database check. To enable it after
# `make db-setup`, point it at the studio_app role, for example
# postgres://studio_app:<STUDIO_DB_APP_PASSWORD>@127.0.0.1:55432/studio?sslmode=disable
# Never point it at the bootstrap superuser.
STUDIO_DATABASE_URL=
